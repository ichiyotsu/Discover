<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="TokiDiscover.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="TokiDiscover">
    <Grid x:Name="Root" KeyDown="Root_KeyDown">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarDrag" Grid.Row="0" Background="Transparent">
            <StackPanel Orientation="Horizontal" Spacing="10" Margin="16,0,168,0" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" Text="TokiDiscover" Style="{ThemeResource CaptionTextBlockStyle}" VerticalAlignment="Center" />
                <Border x:Name="PrivateBadge" Visibility="Collapsed" CornerRadius="8" Padding="8,2"
                        Background="{ThemeResource AccentFillColorDefaultBrush}">
                    <TextBlock x:Name="PrivateBadgeText" Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" FontSize="11" />
                </Border>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="16,2,16,10">
            <Border x:Name="ChromeCard"
                    CornerRadius="16"
                    Padding="10,8"
                    BorderThickness="1"
                    BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                    HorizontalAlignment="Stretch"
                    RenderTransformOrigin="0.5,0">
                <Border.Background>
                    <AcrylicBrush TintColor="{ThemeResource SolidBackgroundFillColorBase}"
                                  TintOpacity="0.62"
                                  FallbackColor="{ThemeResource SolidBackgroundFillColorSecondary}" />
                </Border.Background>
                <Border.RenderTransform>
                    <ScaleTransform x:Name="ChromeScale" ScaleX="1" ScaleY="1" />
                </Border.RenderTransform>
                <StackPanel Spacing="6">
                    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="TabStrip" Orientation="Horizontal" Spacing="4" />
                    </ScrollViewer>
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <AppBarButton x:Name="BackButton" Grid.Column="0" LabelPosition="Collapsed" Icon="Back" Click="Back_Click" />
                        <AppBarButton x:Name="ForwardButton" Grid.Column="1" LabelPosition="Collapsed" Icon="Forward" Click="Forward_Click" />
                        <AppBarButton x:Name="ReloadButton" Grid.Column="2" LabelPosition="Collapsed" Icon="Refresh" Click="Reload_Click" />
                        <AppBarButton x:Name="HomeButton" Grid.Column="3" LabelPosition="Collapsed" Icon="Home" Click="Home_Click" />
                        <TextBox x:Name="AddressBox" Grid.Column="4" KeyDown="Address_KeyDown" GotFocus="Address_GotFocus" LostFocus="Address_LostFocus" />
                        <AppBarButton x:Name="TranslateButton" Grid.Column="5" LabelPosition="Collapsed" Icon="Globe" Click="Translate_Click" />
                        <AppBarButton x:Name="MenuButton" Grid.Column="6" LabelPosition="Collapsed" Icon="More" Click="Menu_Click" />
                    </Grid>
                </StackPanel>
            </Border>

            <Button x:Name="ChromePill"
                    HorizontalAlignment="Center"
                    Visibility="Collapsed"
                    MinWidth="220"
                    Height="40"
                    CornerRadius="20"
                    Padding="16,0"
                    Click="Pill_Click">
                <TextBlock x:Name="PillText" TextTrimming="CharacterEllipsis" MaxWidth="280" />
            </Button>
        </Grid>

        <Grid x:Name="ContentHost" Grid.Row="2">
            <Grid x:Name="WebHost" />
            <Grid x:Name="HomeLayer" Padding="32" Visibility="Collapsed">
                <StackPanel MaxWidth="640" HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="16">
                    <TextBlock x:Name="HomeTitle" Text="TokiDiscover" FontSize="48" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    <TextBlock x:Name="HomeTagline" HorizontalAlignment="Center" Opacity="0.75" FontSize="16" />
                    <TextBox x:Name="HomeBox" FontSize="18" Padding="14,10" CornerRadius="20" KeyDown="HomeBox_KeyDown" />
                    <TextBlock x:Name="EngineLabel" Opacity="0.7" />
                    <StackPanel x:Name="EngineList" Spacing="4" />
                    <TextBlock Text="0.1.0" Opacity="0.5" HorizontalAlignment="Center" />
                </StackPanel>
            </Grid>
        </Grid>

        <InfoBar x:Name="Notice" Grid.Row="2" VerticalAlignment="Bottom" Margin="16,0,16,16" IsOpen="False" IsClosable="True" Severity="Warning" />
    </Grid>
</Window>
