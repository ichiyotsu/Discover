<!-- Matcha palette — same hex as Android Color.kt / iOS TokiPalette (48 tokens, full table in docs/DESIGN.md). -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Color x:Key="TokiPrimaryLight">#FF4C662B</Color><Color x:Key="TokiOnPrimaryLight">#FFFFFFFF</Color>
  <Color x:Key="TokiPrimaryContainerLight">#FFCDEDA3</Color><Color x:Key="TokiOnPrimaryContainerLight">#FF354E16</Color>
  <Color x:Key="TokiSecondaryLight">#FF586249</Color><Color x:Key="TokiSecondaryContainerLight">#FFDCE7C8</Color>
  <Color x:Key="TokiTertiaryLight">#FF386663</Color><Color x:Key="TokiTertiaryContainerLight">#FFBCECE7</Color>
  <Color x:Key="TokiErrorLight">#FFBA1A1A</Color><Color x:Key="TokiBackgroundLight">#FFF9FAEF</Color>
  <Color x:Key="TokiOnBackgroundLight">#FF1A1C16</Color><Color x:Key="TokiSurfaceVariantLight">#FFE1E4D5</Color>
  <Color x:Key="TokiOnSurfaceVariantLight">#FF44483D</Color><Color x:Key="TokiOutlineLight">#FF75796C</Color>
  <Color x:Key="TokiPrimaryDark">#FFB1D18A</Color><Color x:Key="TokiOnPrimaryDark">#FF1F3701</Color>
  <Color x:Key="TokiPrimaryContainerDark">#FF354E16</Color><Color x:Key="TokiOnPrimaryContainerDark">#FFCDEDA3</Color>
  <Color x:Key="TokiSecondaryDark">#FFBFCBAD</Color><Color x:Key="TokiSecondaryContainerDark">#FF404A33</Color>
  <Color x:Key="TokiTertiaryDark">#FFA0D0CB</Color><Color x:Key="TokiTertiaryContainerDark">#FF1F4E4B</Color>
  <Color x:Key="TokiErrorDark">#FFFFB4AB</Color><Color x:Key="TokiBackgroundDark">#FF12140E</Color>
  <Color x:Key="TokiOnBackgroundDark">#FFE2E3D8</Color><Color x:Key="TokiSurfaceVariantDark">#FF44483D</Color>
  <Color x:Key="TokiOnSurfaceVariantDark">#FFC5C8BA</Color><Color x:Key="TokiOutlineDark">#FF8F9285</Color>
  <Color x:Key="TokiSurfaceContainerLight">#FFEEEFE3</Color><Color x:Key="TokiSurfaceContainerDark">#FF1E201A</Color>
  <SolidColorBrush x:Key="TokiPrimaryBrush" Color="#FF4C662B" />
  <SolidColorBrush x:Key="TokiPrimaryContainerBrush" Color="#FFCDEDA3" />
  <CornerRadius x:Key="TokiCardCornerRadius">34,22,34,22</CornerRadius>
  <CornerRadius x:Key="TokiChipCornerRadius">20,20,20,7</CornerRadius>
  <CornerRadius x:Key="TokiCapsuleCornerRadius">36</CornerRadius>
</ResourceDictionary>
