<Window x:Class="TokiDiscover.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="TokiDiscover">
  <Grid>
    <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
    <!-- Top capsule omnibox (Windows adaptation of the Toki floating capsule): back/forward/reload + address + tabs/library/settings entries. -->
    <Border x:Name="OmniboxBar" Grid.Row="0" CornerRadius="36" Margin="12,10,12,6" Padding="6" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
      <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <Button Grid.Column="0" Content="&#xE72B;" FontFamily="Segoe MDL2 Assets" Click="Back_Click" x:Name="BackButton" />
        <Button Grid.Column="1" Content="&#xE72A;" FontFamily="Segoe MDL2 Assets" Click="Forward_Click" x:Name="ForwardButton" />
        <Button Grid.Column="2" Content="&#xE72C;" FontFamily="Segoe MDL2 Assets" Click="Reload_Click" />
        <TextBox x:Name="Omnibox" Grid.Column="3" Margin="6,0" PlaceholderText="搜索或输入网址" KeyDown="Omnibox_KeyDown" />
        <Button Grid.Column="4" Content="标签" Click="Tabs_Click" />
        <Button Grid.Column="5" Content="书库" Click="Library_Click" />
        <Button Grid.Column="6" Content="设置" Click="Settings_Click" />
        <Button Grid.Column="7" Content="+ 标签" Click="NewTab_Click" />
      </Grid>
    </Border>
    <ProgressBar x:Name="LoadProgress" Grid.Row="0" VerticalAlignment="Bottom" Height="2" IsIndeterminate="False" Foreground="{StaticResource TokiPrimaryBrush}" Visibility="Collapsed" />
    <!-- PaneDisplayMode=Auto: sidebar (tab list) auto-collapses when narrow (Tokinote convention). -->
    <NavigationView x:Name="Nav" Grid.Row="1" PaneDisplayMode="Auto" IsBackButtonVisible="Collapsed" SelectionChanged="Nav_SelectionChanged">
      <Frame x:Name="ContentFrame" />
    </NavigationView>
  </Grid>
</Window>
