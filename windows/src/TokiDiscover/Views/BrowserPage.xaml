<Page x:Class="TokiDiscover.Views.BrowserPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Grid>
    <!-- Engine: WebView2 (Evergreen Chromium). The same page hosts the NewTab home until the active tab has a real URL. -->
    <WebView2 x:Name="Web" Visibility="Collapsed" />
    <ScrollViewer x:Name="HomePanel">
      <StackPanel Margin="40,48" Spacing="16" MaxWidth="720" HorizontalAlignment="Center">
        <TextBlock Text="TokiDiscover" FontSize="40" FontWeight="Bold" />
        <TextBlock x:Name="PrivateHint" Text="无痕标签页 — 不会记录历史" Visibility="Collapsed" Opacity="0.6" />
        <TextBox x:Name="HomeSearch" PlaceholderText="搜索或输入网址" KeyDown="HomeSearch_KeyDown" CornerRadius="36" Padding="16,10" />
        <TextBlock Text="常用站点" FontSize="18" FontWeight="SemiBold" />
        <ItemsRepeater x:Name="SpeedDial">
          <ItemsRepeater.Layout><UniformGridLayout MinItemWidth="200" MinItemHeight="72" ItemsStretch="Fill" /></ItemsRepeater.Layout>
          <ItemsRepeater.ItemTemplate><DataTemplate><Button CornerRadius="34,22,34,22" Margin="4" Click="SpeedDial_Click" Tag="{Binding Url}" HorizontalAlignment="Stretch"><StackPanel><TextBlock Text="{Binding Title}" FontWeight="SemiBold" /><TextBlock Text="{Binding Url}" Opacity="0.6" TextTrimming="CharacterEllipsis" /></StackPanel></Button></DataTemplate></ItemsRepeater.ItemTemplate>
        </ItemsRepeater>
        <StackPanel Orientation="Horizontal" Spacing="8">
          <Button Content="收藏当前页" Click="Bookmark_Click" /><Button Content="页内查找" Click="Find_Click" />
          <Button Content="分享" Click="Share_Click" /><Button Content="新建无痕标签" Click="PrivateTab_Click" />
        </StackPanel>
        <TextBox x:Name="FindBox" PlaceholderText="在页面中查找" Visibility="Collapsed" KeyDown="FindBox_KeyDown" />
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
